# Production domain, once confirmed (no trailing slash). Enables canonical URLs,
# absolute Open Graph URLs, and the sitemap reference in robots.txt.
NEXT_PUBLIC_SITE_URL=

# --- Contact form delivery (configure ONE option) ---------------------------
# Option A: Resend (https://resend.com) — sends enquiries by email.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Website <enquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries (defaults to the company email in lib/site.js)
CONTACT_TO_EMAIL=

# Option B: any webhook that accepts a JSON POST (Formspree, Make, Zapier, n8n, a CRM...)
CONTACT_WEBHOOK_URL=
